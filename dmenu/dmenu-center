#!/usr/bin/env bash
# ==============================================================================
# dmenu-center: Launcher wrapper to run dmenu as a centered popup window
# ==============================================================================

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/dmenu/config"
[ ! -f "$CONFIG_FILE" ] && CONFIG_FILE="$SCRIPT_DIR/config"

# Default configuration values
CENTER=true
LINES=10
WIDTH=600
LINE_HEIGHT=24
BORDER_WIDTH=2
FONT="monospace:size=10"
PROMPT="Run:"
COLOR_NB="#000000"
COLOR_NF="#FFFFFF"
COLOR_SB="#F2C791"
COLOR_SF="#000000"

# Load config if present
if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

# Build arguments array
DMENU_ARGS=()

if [ -n "${PROMPT:-}" ]; then
    DMENU_ARGS+=(-p "$PROMPT")
fi

if [ -n "${FONT:-}" ]; then
    DMENU_ARGS+=(-fn "$FONT")
fi

if [ -n "${COLOR_NB:-}" ]; then
    DMENU_ARGS+=(-nb "$COLOR_NB")
fi

if [ -n "${COLOR_NF:-}" ]; then
    DMENU_ARGS+=(-nf "$COLOR_NF")
fi

if [ -n "${COLOR_SB:-}" ]; then
    DMENU_ARGS+=(-sb "$COLOR_SB")
fi

if [ -n "${COLOR_SF:-}" ]; then
    DMENU_ARGS+=(-sf "$COLOR_SF")
fi

if [ -n "${LINES:-}" ] && [ "$LINES" -gt 0 ]; then
    DMENU_ARGS+=(-l "$LINES")
fi

# Locate the real dmenu_run binary (ensuring we do not execute ourselves)
find_real_dmenu_run() {
    local candidate
    local self_real
    self_real="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    while IFS= read -r candidate; do
        [ -z "$candidate" ] && continue
        local cand_real
        cand_real="$(readlink -f "$candidate" 2>/dev/null || echo "$candidate")"
        if [ -x "$candidate" ] && [ "$cand_real" != "$self_real" ]; then
            echo "$candidate"
            return 0
        fi
    done < <(type -ap dmenu_run 2>/dev/null || which -a dmenu_run 2>/dev/null)
    return 1
}

REAL_DMENU_RUN="$(find_real_dmenu_run || true)"

# Execute dmenu launcher
run_launcher() {
    local launcher_args=("$@")
    if [ -n "$REAL_DMENU_RUN" ]; then
        exec "$REAL_DMENU_RUN" "${launcher_args[@]}"
    elif command -v dmenu_path >/dev/null 2>&1 && command -v dmenu >/dev/null 2>&1; then
        dmenu_path | dmenu "${launcher_args[@]}" | ${SHELL:-/bin/sh} &
        exit 0
    elif command -v dmenu >/dev/null 2>&1; then
        local cmd
        cmd="$(IFS=:; for dir in $PATH; do [ -d "$dir" ] && find -L "$dir" -maxdepth 1 -type f -executable -printf "%f\n" 2>/dev/null; done | sort -u | dmenu "${launcher_args[@]}")"
        [ -n "$cmd" ] && exec ${SHELL:-/bin/sh} -c "$cmd" &
        exit 0
    else
        echo "Error: Neither dmenu_run nor dmenu was found in PATH." >&2
        exit 1
    fi
}

# Inspect dmenu capabilities (-c center patch, -x/-y/-w patch, -bw border width)
DMENU_HELP=""
if command -v dmenu >/dev/null 2>&1; then
    DMENU_HELP="$(dmenu -v 2>&1 || true; dmenu 2>&1 || true)"
fi

supports_center_flag() {
    [[ "$DMENU_HELP" == *"-c"* ]]
}

supports_bw_flag() {
    [[ "$DMENU_HELP" == *"-bw"* ]]
}

supports_xyw_flags() {
    [[ "$DMENU_HELP" == *"-x"* ]] && [[ "$DMENU_HELP" == *"-y"* ]]
}

if [ "$CENTER" = true ]; then
    if supports_center_flag; then
        # Native suckless center patch
        DMENU_ARGS+=(-c)
        if supports_bw_flag && [ -n "${BORDER_WIDTH:-}" ] && [ "$BORDER_WIDTH" -gt 0 ]; then
            DMENU_ARGS+=(-bw "$BORDER_WIDTH")
        fi
        run_launcher "${DMENU_ARGS[@]}" "$@"
    elif supports_xyw_flags; then
        # Screen geometry centering calculation with offset support
        screen_w=1920
        screen_h=1080
        offset_x=0
        offset_y=0
        if command -v xrandr >/dev/null 2>&1; then
            read -r sw sh ox oy < <(
                xrandr --current 2>/dev/null | awk '
                    / connected primary/ {
                        for (i=1; i<=NF; i++) {
                            if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
                                split($i, r, /[+x]/)
                                print r[1], r[2], r[3], r[4]
                                exit
                            }
                        }
                    }
                    / connected/ && !found {
                        for (i=1; i<=NF; i++) {
                            if ($i ~ /^[0-9]+x[0-9]+\+[0-9]+\+[0-9]+/) {
                                f_sw=r[1]; f_sh=r[2]; f_ox=r[3]; f_oy=r[4];
                                found=1
                            }
                        }
                    }
                    END {
                        if (found) print f_sw, f_sh, f_ox, f_oy
                    }
                '
            ) || true
            [ -n "${sw:-}" ] && screen_w="$sw"
            [ -n "${sh:-}" ] && screen_h="$sh"
            [ -n "${ox:-}" ] && offset_x="$ox"
            [ -n "${oy:-}" ] && offset_y="$oy"
        elif command -v xdpyinfo >/dev/null 2>&1; then
            read -r sw sh < <(
                xdpyinfo 2>/dev/null | awk '/dimensions:/ { split($2, r, "x"); print r[1], r[2]; exit }'
            ) || true
            [ -n "${sw:-}" ] && screen_w="$sw"
            [ -n "${sh:-}" ] && screen_h="$sh"
        fi

        pos_x=$(( offset_x + (screen_w - WIDTH) / 2 ))
        total_h=$(( (LINES + 1) * LINE_HEIGHT ))
        pos_y=$(( offset_y + (screen_h - total_h) / 2 ))

        DMENU_ARGS+=(-x "$pos_x" -y "$pos_y" -w "$WIDTH")
        run_launcher "${DMENU_ARGS[@]}" "$@"
    else
        # If center patch flag is not detected in help text, try with -c safely if possible, or run vertical menu popup
        # Note: Do NOT use exec before checking return code so fallback executes if -c is rejected!
        if [ -n "$REAL_DMENU_RUN" ]; then
            if ! "$REAL_DMENU_RUN" -c "${DMENU_ARGS[@]}" "$@" 2>/dev/null; then
                exec "$REAL_DMENU_RUN" "${DMENU_ARGS[@]}" "$@"
            fi
        else
            run_launcher "${DMENU_ARGS[@]}" "$@"
        fi
    fi
else
    run_launcher "${DMENU_ARGS[@]}" "$@"
fi
