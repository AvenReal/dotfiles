# ==============================================================================
# dmenu Configuration - Centered Popup Window
# ==============================================================================
# Configures dmenu to appear as a centered popup window instead of a top bar.

# Enable centered popup window mode
CENTER=true

# Number of vertical lines to display in the centered popup
LINES=10

# Width of the centered popup window (in pixels)
WIDTH=600

# Border width (in pixels) for centered popup window
BORDER_WIDTH=2

# Approximate line height (in pixels) for vertical centering calculation
LINE_HEIGHT=24

# Font family and size
FONT="monospace:size=10"

# Prompt string displayed before the input query
PROMPT="Run:"

# Color configuration matching i3 bar and workspace color palette
# Normal item background
COLOR_NB="#000000"
# Normal item foreground (text)
COLOR_NF="#FFFFFF"
# Selected item background (accent color)
COLOR_SB="#F2C791"
# Selected item foreground (text)
COLOR_SF="#000000"
